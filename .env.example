DATABASE_URL=postgresql://user:pass@neon.tech/learnquest
REDIS_URL=redis://localhost:6379
NODE_ENV=development
PORT=3000

# Service ports
USER_SVC_URL=http://localhost:3002
GAME_SVC_URL=http://localhost:3003
ABOA_SVC_URL=http://localhost:3004
ANALYTICS_SVC_URL=http://localhost:3005
RT_SVC_URL=http://localhost:3006
AI_SVC_URL=http://localhost:3007

# Clerk auth (Google + GitHub OAuth via Clerk dashboard)
# Issuer e.g. https://<your-instance>.clerk.accounts.dev
CLERK_ISSUER=
CLERK_AUDIENCE=
# Frontend (Vite injects via import.meta.env)
VITE_CLERK_PUBLISHABLE_KEY=

# Gemini (question generation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
